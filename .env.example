# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=*

# Database — SQLite is the default (no setup needed; db.sqlite3 file in project root).
# To switch to PostgreSQL, uncomment the lines below and run scripts/setup_postgres.sql.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=school_erp
# DB_USER=school_erp_user
# DB_PASSWORD=change-me-to-a-strong-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10

# School branding
SCHOOL_NAME=Your School Name
SCHOOL_TAGLINE=Excellence in Education
SCHOOL_ADDRESS=123 Education Street, Your City, Your Country
SCHOOL_PHONE=+1 (555) 123-4567
SCHOOL_EMAIL=info@yourschool.edu

# Payment gateway — choose: "test" (dev only) / "stripe" / "jazzcash"
ACTIVE_PAYMENT_GATEWAY=test

# Stripe (international) — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook secret from Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=

# JazzCash (Pakistan) — get from your merchant account
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:8000/fees/payment/jazzcash/return/
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/2.0/Payment/DoPayment

# Two-Factor Authentication issuer name (shown in authenticator apps)
OTP_ISSUER=School ERP

# Email (for "Forgot password" — prints to console in dev, sends via SMTP in prod)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your.email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourschool.edu

